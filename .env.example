# Root-level overrides for docker-compose. Copy to `.env` to customize.
# All values have sensible defaults baked into docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=singmeasong

# API URL baked into the frontend bundle at build time.
# Must be reachable from the browser (use the host's address, not "backend").
REACT_APP_API_BASE_URL=http://localhost:5000
