# Separate database used by the automated test suite (npm test / test:integration).
# Point this at a THROWAWAY database — `npm test` resets/truncates it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sing_me_a_song_test?schema=public"

PORT=5000

# The test router (/tests/reset) must be reachable for the e2e/reset helper.
MODE=TEST
