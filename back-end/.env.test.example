# Used by the npm test/dev:test scripts through dotenv-cli (-e .env.test).
# Point it at a DISPOSABLE database: the test suite truncates tables and
# 'npm test' runs prisma migrate reset against it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sing_me_a_song_test

PORT=5000

# TEST mode mounts DELETE /tests/reset, which the Cypress suite calls.
MODE=TEST
