# ---------------------------------------------------------------------------
# Sing me a Song - back-end environment (automated tests)
# Copy this file to `.env.test` and replace the placeholders with real values.
# The jest and Cypress suites TRUNCATE / RESET this database, so it MUST point
# at a throw-away database - never at your development or production one.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/singmeasong_test?schema=public"

PORT=5000

NODE_ENV=test

# Required: enables the DELETE /tests/reset route the Cypress suite relies on.
MODE=TEST
