# Test-database connection string used by Prisma during `npm test`.
# Use a SEPARATE database from development — the test suite truncates/resets it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singmeasong_test?schema=public"

PORT=5000

# Enables the /tests router (e.g. DELETE /tests/reset) used by the E2E suite.
MODE=TEST
