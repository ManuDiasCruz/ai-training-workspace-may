# ---------------------------------------------------------------------------
# Back-end TEST environment variables.
# Copy this file to `.env.test` and fill in the values.
# Use a SEPARATE database from development — the test suite wipes/resets it.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the dedicated test database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singmeasong_test?schema=public"

# Port used when running the API in test mode.
PORT=5001

# Enables the /tests routes (e.g. DELETE /tests/reset) used by E2E tests.
# Must be exactly "TEST".
MODE=TEST
