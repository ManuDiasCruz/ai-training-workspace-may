# PostgreSQL connection string for the isolated test database.
# WARNING: the test suite runs `prisma migrate reset` against this database,
# wiping it on every run — never point it at the development/production DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/singmeasong_test

PORT=5000

# MODE=TEST mounts the /tests/reset router used by the Cypress E2E suite
MODE=TEST
