# Environment used by the automated tests (npm test) and `npm run dev:test`.
# WARNING: tests TRUNCATE the recommendations table — always point this at a
# dedicated test database, never at development or production data.
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/singmeasong_test

# Exposes DELETE /tests/reset (used by the Cypress end-to-end tests)
MODE=TEST
