{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "es2020",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "target": "es2020",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests"],
  "ts-node": {
    "esm": true
  }
}
