{
  "name": "sing-me-a-song-api",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec node --loader ts-node/esm src/server.ts",
    "dev:test": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- cross-env MODE=TEST nodemon --watch src --ext ts --exec node --loader ts-node/esm src/server.ts",
    "migrate:deploy": "prisma migrate deploy",
    "test:integration": "dotenv -e .env.test -- cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration",
    "test:unit": "dotenv -e .env.test -- cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "prisma:test": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "test": "npm run prisma:test && npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/joi": "^17.2.3",
    "@types/node": "^16.3.3",
    "@types/supertest": "^2.0.11",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "nodemon": "^2.0.12",
    "prisma": "^3.13.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "joi": "^17.13.4",
    "react-player": "^2.10.0"
  }
}
