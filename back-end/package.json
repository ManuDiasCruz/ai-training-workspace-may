{
  "name": "sing-me-a-song-back",
  "version": "1.0.0",
  "type": "module",
  "description": "Sing me a Song backend API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:test": "dotenv -e .env.test prisma migrate deploy && dotenv -e .env.test tsx watch src/server.ts",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "test:integration": "dotenv -e .env.test -- jest -i ./tests/integration",
    "test:unit": "dotenv -e .env.test -- jest -i ./tests/unit",
    "prisma-test": "dotenv -e .env.test -- prisma migrate reset --skip-seed --force",
    "test": "npm run prisma-test && NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest -i"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/node": "^16.3.3",
    "@types/supertest": "^2.0.11",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "nodemon": "^2.0.12",
    "prisma": "^3.13.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "ts-node": "^10.7.0",
    "tsx": "^4.22.2",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1",
    "random-youtube-music-video": "^1.0.6"
  }
}
