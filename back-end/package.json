{
  "name": "sing-me-a-song-api",
  "version": "1.0.0",
  "type": "module",
  "description": "API for Sing Me a Song recommendations",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm\" src/server.ts",
    "dev:test": "npm run db:migrate:test && dotenv -e .env.test -- npm run dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "test:unit": "cross-env DATABASE_URL=postgresql://localhost:5432/sing_me_a_song_unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand tests/integration",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/node": "^16.3.3",
    "@types/supertest": "^2.0.11",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "nodemon": "^2.0.12",
    "prisma": "^3.13.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1"
  }
}
