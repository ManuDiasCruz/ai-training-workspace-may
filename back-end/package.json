{
  "name": "typescript-back-template",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "prisma migrate deploy",
    "db:reset:test": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand tests/integration"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@jest/globals": "28.1.3",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/node": "22.20.1",
    "@types/supertest": "^2.0.11",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "prisma": "5.22.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "tsx": "4.23.13",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1"
  }
}
