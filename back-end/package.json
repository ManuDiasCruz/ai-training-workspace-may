{
  "name": "sing-me-a-song-back",
  "version": "1.0.0",
  "type": "module",
  "description": "Sing me a Song API - Express + Prisma + PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"node --no-warnings --loader ts-node/esm\" src/server.ts",
    "dev:test": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- npm run dev",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma-test": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed --skip-generate",
    "test": "npm run prisma-test && cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest -i",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest -i tests/integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest -i tests/unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/node": "^16.3.3",
    "@types/supertest": "^2.0.11",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "nodemon": "^2.0.12",
    "prisma": "^3.13.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1"
  }
}
