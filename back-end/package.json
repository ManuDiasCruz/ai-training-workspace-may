{
  "name": "sing-me-a-song-api",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API for the Sing me a Song recommendation app",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "db:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/server.ts\"",
    "dev:test": "dotenv -e .env.test -- nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/server.ts\"",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand tests/integration",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules dotenv -e .env.test -- jest --runInBand tests/unit",
    "prisma-test": "dotenv -e .env.test -- prisma migrate deploy",
    "test": "npm run test:unit && npm run prisma-test && npm run test:integration"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.0",
    "@types/joi": "^17.2.3",
    "@types/node": "^16.3.3",
    "@types/supertest": "^2.0.11",
    "dotenv-cli": "^5.1.0",
    "jest": "^28.0.3",
    "nodemon": "^2.0.12",
    "prisma": "^3.13.0",
    "supertest": "^6.1.3",
    "ts-jest": "^28.0.0",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "@prisma/client": "^3.13.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1"
  },
  "engines": {
    "node": ">=18 <21"
  }
}
