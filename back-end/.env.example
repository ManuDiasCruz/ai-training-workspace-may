# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sing_me_a_song?schema=public"

# Port the API server listens on (defaults to 5000 if omitted).
PORT=5000

# Set to "TEST" to expose the /tests router (used only by the e2e/reset helper).
# Leave unset in production.
# MODE=TEST
