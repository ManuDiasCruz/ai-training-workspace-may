# ---------------------------------------------------------------------------
# Back-end environment variables
# Copy this file to `.env` (development) and `.env.test` (automated tests)
# and fill in the values. Never commit the real .env files.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singmeasong?schema=public"

# Port the Express server listens on (defaults to 5000 if omitted).
PORT=5000

# Set to "TEST" to expose the /tests helper routes used by the e2e suite.
# Leave unset (or any other value) in production/development.
# MODE=TEST
