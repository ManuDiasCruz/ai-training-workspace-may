# ---------------------------------------------------------------------------
# Sing me a Song - back-end environment (development)
# Copy this file to `.env` and replace the placeholders with real values.
# NEVER commit the resulting `.env` file: it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/singmeasong?schema=public"

# Port the Express server listens on (defaults to 5000 when unset).
PORT=5000

# Node environment: development | test | production
NODE_ENV=development

# Set to "TEST" to expose the DELETE /tests/reset helper route used by the
# Cypress end-to-end suite. Leave it unset in production.
# MODE=TEST
