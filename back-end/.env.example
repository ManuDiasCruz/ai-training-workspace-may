# PostgreSQL connection string for local development. Replace placeholders locally.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sing_me_a_song?schema=public
PORT=5000
# Comma-separated browser origins. Same-origin production hosting does not require this.
CORS_ORIGIN=http://localhost:3000
# Set true only when the React production build is served by this API process.
SERVE_FRONTEND=false
