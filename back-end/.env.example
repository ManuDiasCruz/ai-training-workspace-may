# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sing_me_a_song?schema=public"

# Port the Express server listens on (defaults to 5000 if unset).
PORT=5000

