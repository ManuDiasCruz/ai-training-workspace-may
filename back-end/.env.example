# Use a database and credentials you control. Do not commit your real .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sing_me_a_song?schema=public
PORT=5000
# Comma-separated browser origins allowed to read cross-origin API responses.
CORS_ORIGIN=http://localhost:3000
# Set only for a same-origin production build served by the API.
SERVE_FRONTEND=false
