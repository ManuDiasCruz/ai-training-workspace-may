# ---------------------------------------------------------------------------
# Back-end environment variables (development / production)
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singmeasong?schema=public"

# Port the Express API listens on (defaults to 5000 if omitted).
PORT=5000
