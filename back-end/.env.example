# Copy this file to `.env` (development) and `.env.test` (automated tests) and
# fill in real values. Both files are gitignored -- never commit credentials.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use a DIFFERENT database in .env.test: `npm test` wipes it on every run.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singmeasong?schema=public"

# Port the API listens on. Defaults to 5000 when unset.
PORT=5000

# Set to TEST to expose the /tests helper routes (DELETE /tests/reset and
# POST /tests/seed) used by the Cypress end-to-end suite.
# Leave unset in production: these routes can wipe the database.
# MODE=TEST
