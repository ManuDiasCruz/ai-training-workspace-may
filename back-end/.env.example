# PostgreSQL connection string used by Prisma (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/singmeasong

# Port the API listens on (optional, default 5000)
PORT=5000

# Set MODE=TEST to mount DELETE /tests/reset (used by the E2E suite).
# Leave unset in production!
# MODE=TEST

# Comma-separated list of allowed CORS origins (optional).
# When unset, every origin is allowed.
# CORS_ORIGIN=http://localhost:3000
