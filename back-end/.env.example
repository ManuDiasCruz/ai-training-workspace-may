# ---------------------------------------------------------------------------
# Sing me a Song - API environment variables
#
# Copy this file to `.env` (development) and `.env.test` (automated tests):
#   cp .env.example .env
#   cp .env.example .env.test
#
# NEVER commit the real `.env` / `.env.test` files - they are git-ignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Use a DIFFERENT database in `.env.test`, because the test suite truncates it.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/singmeasong?schema=public"

# Port the HTTP server listens on. Defaults to 5000 when unset.
PORT=5000

# Node environment: development | test | production
NODE_ENV=development

# When set to exactly "TEST" the API also exposes the destructive helper route
# DELETE /tests/reset, which truncates the recommendations table. It is required
# by the Cypress end-to-end suite. LEAVE THIS UNSET IN PRODUCTION.
MODE=TEST
