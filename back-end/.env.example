# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sing_me_a_song

# Port the Express server listens on (defaults to 5000 when unset)
PORT=5000

# Set to TEST to expose DELETE /tests/reset (used by the Cypress suite).
# Leave as DEV (or unset) in any real environment.
MODE=DEV
