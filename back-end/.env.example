# ---------------------------------------------------------------------------
# Sing me a Song - API environment variables
# Copy this file to `.env` (development) and `.env.test` (automated tests).
# Never commit the real `.env` / `.env.test` files - they are gitignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma. Required.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/singmeasong?schema=public

# Port the API listens on. Optional, defaults to 5000.
PORT=5000

# Set to TEST to expose the DELETE /tests/reset helper used by the E2E suite.
# Leave unset (or any other value) in production - the route stays disabled.
MODE=

# Comma-separated list of origins allowed by CORS. Optional.
# When unset every origin is allowed (convenient for local development).
# Example: CORS_ORIGIN=http://localhost:3000,https://my-front-end.example.com
CORS_ORIGIN=
