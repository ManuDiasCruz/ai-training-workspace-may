# ---------------------------------------------------------------------------
# Sing me a Song - front-end environment variables
#
# Copy this file to `.env` before running `npm start`:
#   cp .env.example .env
#
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them at BUILD time - a production bundle must be rebuilt after this
# value changes. NEVER put secrets here: everything ends up in the bundle and
# is publicly readable.
# ---------------------------------------------------------------------------

# Base URL of the Sing me a Song API, with no trailing slash.
# Local development (matches the default PORT in back-end/.env.example):
REACT_APP_API_BASE_URL=http://localhost:5000
# Deployed example:
# REACT_APP_API_BASE_URL=https://sing-me-a-song-api.onrender.com
