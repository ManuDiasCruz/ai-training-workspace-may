# ---------------------------------------------------------------------------
# Sing me a Song - front-end environment
# Copy this file to `.env` and adjust the values.
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them at BUILD time - rebuild after changing anything here.
# NEVER put secrets in this file: everything here ships to the browser.
# ---------------------------------------------------------------------------

# Base URL of the Sing me a Song API, with no trailing slash.
# Local development default:
REACT_APP_API_BASE_URL=http://localhost:5000

# Deployed example (must be https when the front-end is served over https,
# otherwise the browser blocks the request as mixed content):
# REACT_APP_API_BASE_URL=https://sing-me-a-song-api.example.com
