+def _stringify_int_first_segment(path: list[str | int]) -> list[str | int]:
+    """Return ``path`` with an integer first segment converted to a string.
+
+    pydantic-core's ``LookupPath`` requires the first item of an alias path to be a
+    string (it indexes a dict-like input). To support ``AliasPath(0)``-style aliases
+    that index a top-level list input, we stringify the first integer segment here
+    and pair it with a model-level pre-validator that maps list inputs to dicts
+    keyed by stringified indices (see ``_list_to_dict_for_int_aliases``).
+    """
+    if path and isinstance(path[0], int):
+        return [str(path[0]), *path[1:]]
+    return path
+
+
+def _alias_has_int_first_segment(alias: str | AliasChoices | AliasPath | None) -> bool:
+    """Return True if ``alias`` (or any of its choices) starts with an integer segment."""
+    if isinstance(alias, AliasPath):
+        return bool(alias.path) and isinstance(alias.path[0], int)
+    if isinstance(alias, AliasChoices):
+        return any(
+            isinstance(c, AliasPath) and c.path and isinstance(c.path[0], int) for c in alias.choices
+        )
+    return False
+
+
+def _list_to_dict_for_int_aliases(value: Any) -> Any:
+    """Convert a top-level list/tuple input to a dict keyed by stringified indices.
+
+    Used as a before-validator on models whose fields reference list positions via
+    ``AliasPath`` with an integer first segment (issue #13112).
+    """
+    if isinstance(value, (list, tuple)):
+        return {str(i): item for i, item in enumerate(value)}
+    return value
+
+
