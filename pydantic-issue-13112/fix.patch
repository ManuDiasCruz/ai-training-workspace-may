diff --git a/pydantic/aliases.py b/pydantic/aliases.py
index a88a6f8..c8736d7 100644
--- a/pydantic/aliases.py
+++ b/pydantic/aliases.py
@@ -25,6 +25,16 @@ class AliasPath:
     path: list[int | str]
 
     def __init__(self, first_arg: str, *args: str | int) -> None:
+        # The first segment must be a string dict key: ``pydantic-core`` only
+        # supports indexing by ``int`` *after* a string lookup. Validating
+        # eagerly produces a clear error at ``AliasPath`` construction instead
+        # of an opaque ``SchemaError`` at model definition time (see #13112).
+        if not isinstance(first_arg, str):
+            raise TypeError(
+                f'`AliasPath` first argument must be a `str`, got {type(first_arg).__name__!r}. '
+                'Indexing top-level list/tuple inputs by integer is not supported; '
+                'see https://github.com/pydantic/pydantic/issues/13112.'
+            )
         self.path = [first_arg] + list(args)
 
     def convert_to_aliases(self) -> list[str | int]:
