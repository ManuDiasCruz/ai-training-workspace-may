@@ -611,6 +611,21 @@ def test_search_dict_for_alias_path():
     assert ap.search_dict_for_path({'a': 'hello'}) is PydanticUndefined
 
 
+def test_alias_path_int_first_segment_raises_type_error():
+    """Regression test for https://github.com/pydantic/pydantic/issues/13112.
+
+    An ``int`` as the first ``AliasPath`` segment is not supported by
+    ``pydantic-core`` (which expects the first segment to be a string dict
+    key). Previously this surfaced as an opaque ``SchemaError`` at model
+    definition time. ``AliasPath`` now raises a clear ``TypeError`` at
+    construction.
+    """
+    with pytest.raises(TypeError, match=r'first argument.*must be a `str`'):
+        AliasPath(0)
+    with pytest.raises(TypeError, match=r'first argument.*must be a `str`'):
+        AliasPath(0, 'name')
+
+
 def test_validation_alias_invalid_value_type():
