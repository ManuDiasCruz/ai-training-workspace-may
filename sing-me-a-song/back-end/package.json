{
  "name": "sing-me-a-song-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Song recommendations API backed by PostgreSQL",
  "main": "dist/server.js",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:test": "node scripts/test.mjs serve",
    "db:migrate": "prisma migrate deploy",
    "test:integration": "node scripts/test.mjs integration",
    "test:unit": "node scripts/test.mjs unit",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^2.0.11",
    "jest": "^29.7.0",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "joi": "^17.13.3",
    "prisma": "6.19.0"
  }
}
