{
  "name": "sing-me-a-song-api",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:test": "dotenv -e .env.test -- tsx watch src/server.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "dotenv -e .env.test -- node scripts/migrate-test.mjs",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/unit",
    "test:integration": "dotenv -e .env.test -- cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/integration",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^7.3.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@types/supertest": "^2.0.11",
    "dotenv-cli": "^5.1.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "joi": "^17.4.1"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
